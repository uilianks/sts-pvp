<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loads sts2.dll + StsPvp.dll in a plain .NET process and applies every Harmony patch. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/Slay the Spire 2</GameDir>
    <GameData Condition="'$(GameData)' == ''">$(GameDir)/data_sts2_linuxbsd_x86_64</GameData>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$(GameData)/0Harmony.dll" Private="true" />
  </ItemGroup>
</Project>
